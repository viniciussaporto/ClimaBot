# Deployment scripts run on Linux; keep LF endings on every checkout.
*.sh text eol=lf
deploy/climabot text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.json text eol=lf
deploy/systemd/* text eol=lf
# Source and docs too, so formatting checks give the same result everywhere.
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
Cargo.lock text eol=lf

[Unit]
Description=Nightly ClimaBot update: git pull, rebuild and restart the running bot (+ dashboards, alerts)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/bin/climabot nightly
TimeoutStartSec=45min

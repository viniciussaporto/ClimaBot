#!/usr/bin/env bash
# ClimaBot deployment helper: builds, starts and updates the bot.
#
#   climabot start             pull + rebuild the bot, start the stack
#   climabot update            pull + rebuild + restart the running bot
#   climabot stop              stop the stack
#   climabot status            show what is running
#   climabot logs              follow the bot's logs
#   climabot failed-sites      shops where /pt add couldn't find a price
#   climabot nightly           update if the bot is running (run daily by climabot-update.timer)
#
# Installed by deploy/install.sh, which also installs the climabot-* shell
# shortcuts and SSH login banner (/etc/profile.d/climabot.sh). The checkout
# and branch can be overridden through the variables below (e.g. in
# /etc/default/climabot). Production follows `main`; `preprod` is where
# changes land first.

set -euo pipefail

[[ -r /etc/default/climabot ]] && . /etc/default/climabot

RUST_DIR=${CLIMABOT_RUST_DIR:-/root/climabot-rust}         # git checkout + compose project
RUST_BRANCH=${CLIMABOT_RUST_BRANCH:-main}
MONITORING_NETWORK=${CLIMABOT_MONITORING_NETWORK:-climabot-monitoring}

# Colours only in a terminal (the nightly run logs to the journal).
if [[ -t 1 ]]; then
    log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
    die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
else
    log() { printf '==> %s\n' "$*"; }
    die() { printf 'error: %s\n' "$*" >&2; exit 1; }
fi

rust_compose() { docker compose --project-directory "$RUST_DIR" -f "$RUST_DIR/docker-compose.yml" "$@"; }

rust_running() { [[ -f "$RUST_DIR/docker-compose.yml" ]] && [[ -n "$(rust_compose ps -q --status running climabot 2>/dev/null)" ]]; }

git_pull() {
    local dir=$1 branch=$2
    [[ -d "$dir/.git" ]] || die "$dir is not a git checkout"
    log "Pulling $branch in $dir"
    git -C "$dir" fetch --prune origin "$branch"
    git -C "$dir" checkout -q "$branch"
    git -C "$dir" merge --ff-only "origin/$branch"
    git -C "$dir" log --oneline -1
}

ensure_network() {
    docker network inspect "$MONITORING_NETWORK" >/dev/null 2>&1 || {
        log "Creating network $MONITORING_NETWORK"
        docker network create "$MONITORING_NETWORK" >/dev/null
    }
}

# The bot runs as uid 10001 and writes its logs to a host directory (shipped
# to Loki from there). Docker creates a missing bind-mount source owned by
# root, and so might the website stack's Alloy mount: fix the owner each time.
ensure_log_dir() {
    local dir
    dir=$(sed -n 's/^CLIMABOT_LOG_DIR=//p' "$RUST_DIR/.env" 2>/dev/null | tail -n 1)
    dir=${dir//[\"\']/}
    dir=${dir:-/var/log/climabot}
    install -d -m 0755 "$dir"
    chown 10001:10001 "$dir"
}

# Wait for the bot to log in to Discord (or give up after ~90 s). Only log
# lines written after `since` count, so an earlier login can't fool it.
wait_for_login() {
    local since=$1
    log "Waiting for the bot to log in to Discord"
    for _ in $(seq 1 45); do
        if rust_compose logs --since "$since" climabot 2>&1 | grep -q "Logged in to Discord"; then
            log "Bot is online"
            return 0
        fi
        sleep 2
    done
    rust_compose logs --tail 30 climabot || true
    die "bot did not report a Discord login; see the logs above"
}

build_rust() {
    git_pull "$RUST_DIR" "$RUST_BRANCH"
    # The pulled checkout may carry a newer version of this tooling.
    log "Refreshing the climabot command"
    "$RUST_DIR/deploy/install.sh" >/dev/null
    log "Pulling images (MongoDB, FlareSolverr, Byparr)"
    rust_compose pull --ignore-buildable --quiet
    log "Building the bot"
    rust_compose build climabot
}

# Start the stack, then always recreate the bot container so it restarts
# even when nothing changed (MongoDB and the browsers are left alone).
up_rust() {
    ensure_network
    ensure_log_dir
    log "Starting the stack"
    local since
    since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    rust_compose up -d --remove-orphans
    rust_compose up -d --no-deps --force-recreate climabot
    wait_for_login "$since"
}

cmd_start() {
    build_rust          # build first so a running bot stays up meanwhile
    up_rust
}

cmd_update() {
    rust_running || die "the bot is not running; use 'climabot start'"
    build_rust
    up_rust
}

cmd_stop() {
    # Checks every service of the stack, so MongoDB and the browsers are
    # stopped too even if the bot itself already exited.
    if [[ -f "$RUST_DIR/docker-compose.yml" && -n "$(rust_compose ps -q --status running 2>/dev/null)" ]]; then
        log "Stopping the stack"
        rust_compose stop
        log "Stopped"
    else
        log "The bot was not running"
    fi
}

# Scheduled by climabot-update.timer. A bot that was stopped on purpose
# stays stopped.
cmd_nightly() {
    log "Nightly update ($(date -u '+%F %T UTC'))"
    if rust_running; then
        cmd_update
    else
        log "The bot is not running; nothing to update"
    fi
}

cmd_logs() {
    rust_running || die "the bot is not running"
    rust_compose logs -f --tail 100 climabot
}

# Filled by /pt add (MongoDB `failed_sites`, one entry per shop).
cmd_failed_sites() {
    [[ -n "$(rust_compose ps -q --status running mongo 2>/dev/null)" ]] || die "MongoDB is not running"
    rust_compose exec -T mongo mongosh climabot --quiet --eval '
        const sites = db.failed_sites.find().sort({ last_seen: -1 }).toArray();
        if (!sites.length) { print("No failed sites recorded."); quit(); }
        for (const s of sites) {
            print(`${s._id}  (${s.count}x, last ${s.last_seen.toISOString().slice(0, 16).replace("T", " ")} UTC)`);
            print(`  ${s.last_reason}`);
            print(`  ${s.last_url}`);
        }'
}

cmd_status() {
    if rust_running; then
        echo "Bot: running ($(git -C "$RUST_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null) $(git -C "$RUST_DIR" log --oneline -1 2>/dev/null))"
        rust_compose ps --format '  {{.Service}}: {{.Status}}'
    else
        echo "Bot: stopped"
    fi
    local next
    next=$(systemctl show climabot-update.timer -p NextElapseUSecRealtime --value 2>/dev/null || true)
    [[ -n "$next" && "$next" != "n/a" ]] && echo "Next nightly update: $next"
    return 0
}

case "${1:-}" in
    start | start-rust) cmd_start ;;
    update) cmd_update ;;
    stop) cmd_stop ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    failed-sites) cmd_failed_sites ;;
    nightly) cmd_nightly ;;
    *)
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac

# Discord bot token from https://discord.com/developers/applications
# (TOKEN is also accepted, for compatibility with the old TypeScript deployment)
DISCORD_TOKEN=

# API key from https://opencagedata.com
OPENCAGEAPIKEY=

# MongoDB for price tracking. docker-compose.yml points these at its own
# mongo service; only needed when running the bot outside compose.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=climabot

# ── Price-tracker fetching ──
# Challenge-solving browsers, tried in this order after a direct request;
# compose points these at its own services. Unset = not used.
# FLARESOLVERR_URL=http://flaresolverr:8191
# BYPARR_URL=http://byparr:8191
# Browser instances each may run at once. Raising these needs a matching
# raise of the *_MEM_LIMIT below (~500 MB per Chrome, ~1 GB per Camoufox).
# FLARESOLVERR_CONCURRENCY=1
# BYPARR_CONCURRENCY=1
# Route all scraping through a proxy (http://user:pass@host:port or
# socks5://host:port). A residential proxy gets past shops that block
# datacenter IPs outright (e.g. Mercado Livre's website) and shows prices for
# the proxy's country.
# SCRAPER_PROXY=
# Mercado Livre / Mercado Libre API app (https://developers.mercadolivre.com.br);
# lets Mercado Livre links work without a residential proxy.
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=

# Compose only: browser memory caps (include the 512 MB /dev/shm)
# FLARESOLVERR_MEM_LIMIT=1536m
# BYPARR_MEM_LIMIT=2g

# Compose only: host directory for logs (default: /var/log/climabot, owned by uid 10001),
# host port for /metrics, Mongo cache size, shared monitoring network name
# CLIMABOT_LOG_DIR=/var/log/climabot
# METRICS_HOST_PORT=9465
# MONGO_CACHE_GB=0.25
# MONITORING_NETWORK=climabot-monitoring

# Directory for daily-rotated JSON logs (default: /var/log/climabot)
# LOG_DIR=/var/log/climabot

# Port that serves Prometheus /metrics (default: 9464)
# METRICS_PORT=9464

# Log level (trace | debug | info | warn | error)
RUST_LOG=info
